---
import Link from "./Link.astro";

const { demo, link, blog, blogHref, t } = Astro.props;

const actions = [
  { show: demo, text: t.watchDemo, href: demo, target: "_blank", rel: "noopener" },
  { show: blog, text: t.readBlog, href: blogHref },
  { show: link, text: t.visitWebsite, href: link },
].filter((btn) => btn.show);

const VARIANTS = ["secondary", "secondary-reversed", "tertiary"] as const;
---

<div class="flex justify-center flex-wrap gap-3">
  {
    actions.map((btn, i) => {
      return (
        <Link
          text={btn.text}
          href={btn.href}
          target={btn.target}
          rel={btn.rel}
          variant={VARIANTS[i] ?? "tertiary"}
        />
      );
    })
  }
</div>
