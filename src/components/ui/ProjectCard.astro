---
import { render } from "astro:content";
import Badge from "./Badge.astro";
import Link from "./Link.astro";
import ProjectActions from "./ProjectActions.astro";

const { project, t, locale } = Astro.props;
const { Content } = await render(project);

const blogHref = locale === "es" ? `/es/projects/${project.id}` : `/projects/${project.id}`;
const summaryParagraphs = project.data.summary
  ? project.data.summary
      .split("\n\n")
      .map((paragraph: string) => paragraph.trim())
      .filter(Boolean)
  : null;
console.log(project.data.demo);
---

<article class="bg-on-tertiary shadow-(--box-shadow-tertiary) max-w-[400px] h-auto">
  <div class="py-4" style={`background-color: ${project.data.color}`}>
    <img
      class="h-15 mx-auto"
      src={`/logos/${project.data.image}.webp`}
      alt={`Logo de ${project.data.title}`}
    />
  </div>
  <div class="bg-on-tertiary p-5 flex flex-col gap-5">
    <h3 class="font-bebas text-2xl md:text-4xl">{project.data.title}</h3>
    <div class="flex flex-row flex-wrap gap-2">
      {
        project.data.tags?.map((tag: string) => {
          return <Badge text={tag} />;
        })
      }
    </div>

    {
      summaryParagraphs ? (
        <div class="md:text-xl md:leading-8 space-y-5">
          {summaryParagraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <div class="md:text-xl md:leading-8 space-y-5">
          <Content entry={project} />
        </div>
      )
    }

    <ProjectActions
      demo={project.data?.demo}
      link={project.data?.link}
      blog={project.data?.blog}
      blogHref={blogHref}
      t={t.projects}
    />
  </div>
</article>
