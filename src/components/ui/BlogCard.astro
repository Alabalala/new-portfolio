---
const { blog, locale } = Astro.props;
const blogHref = locale === "es" ? `/es/blog/${blog.slug}` : `/blog/${blog.slug}`;
const formattedDate = new Intl.DateTimeFormat(locale === "es" ? "es-ES" : "en-US", {
  dateStyle: "long",
}).format(blog.data.date);
---

<a
  href={blogHref}
  class="block max-w-[420px] h-auto transition-transform duration-300 hover:-translate-y-1 focus-visible:-translate-y-1"
>
  <article class="bg-on-tertiary shadow-(--box-shadow-secondary) border-2 border-tertiary">
    <div class="flex items-center justify-between px-5 pt-4">
      <p class="text-xs uppercase tracking-[0.3em] text-secondary">Blog</p>
      <div class="h-1 w-10 bg-secondary"></div>
    </div>
    {blog.data.cover && (
      <div class="py-4" style={`background-color: var(--color-secondary)`}>
        <img class="h-24 mx-auto object-contain" src={blog.data.cover} alt={blog.data.title} />
      </div>
    )}
    <div class="bg-on-tertiary p-5 flex flex-col gap-4">
      <div class="flex flex-col gap-2">
        <p class="text-xs uppercase tracking-[0.2em] text-secondary">{formattedDate}</p>
        <h3 class="font-bebas text-2xl md:text-4xl text-tertiary">{blog.data.title}</h3>
      </div>

      <div class="md:text-xl md:leading-8 space-y-4 text-tertiary">
        <p>{blog.data.summary}</p>
      </div>
    </div>
  </article>
</a>
