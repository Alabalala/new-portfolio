---
import { getCollection } from "astro:content";
import H2 from "../ui/H2.astro";
import BlogCard from "../ui/BlogCard.astro";

const { t, locale } = Astro.props;
const blogsRaw = await getCollection("blogs");
const blogs = blogsRaw.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<section
  id="blogs"
  class="bg-tertiary w-full flex flex-col items-center gap-5 px-10 py-10 md:py-20 shadow-[inset_0px_5px_6px_0px_rgba(0,_0,_0,_0.1)]"
>
  <H2>{t.blogs.title}</H2>
  <div class="flex flex-row justify-center flex-wrap gap-5">
    {blogs.map((blog) => (
      <BlogCard t={t} blog={blog} locale={locale} />
    ))}
  </div>
</section>
